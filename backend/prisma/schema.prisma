// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  CANCELLED
  FAILED
}

enum Genre {
  COMEDY
  THRILLER
  DRAMA
  HORROR
  ANIMATED
  ACTION
  OTHERS
}

enum SeatType {
  SILVER
  GOLD
  PLATINUM
}

model Movie {
  id          String     @id @default(uuid())
  title       String
  description String?
  genre       Genre      @default(OTHERS)
  duration    Int
  imagePath   String     @default("")
  featured    Boolean    @default(false)       
  showtimes   Showtime[]
}

model Theater {
  id       String   @id @default(uuid())
  name     String
  location String
  screens  Screen[]
}

model Screen {
  id        String     @id @default(uuid())
  name      String
  theaterId String
  theater   Theater    @relation(fields: [theaterId], references: [id])
  seats     Seat[]
  showtimes Showtime[]
}

model Seat {
  id       String    @id @default(uuid())
  row      String
  number   Int
  type     SeatType @default(SILVER) // Could also be an enum
  screenId String
  screen   Screen    @relation(fields: [screenId], references: [id])
  bookings Booking[]
}

model Showtime {
  id         String     @id @default(uuid())
  startTime  DateTime
  movieId    String
  movie      Movie      @relation(fields: [movieId], references: [id])
  screenId   String
  screen     Screen     @relation(fields: [screenId], references: [id])
  // Base price for a standard seat at this specific showtime
  basePrice Decimal  @default(10.00) @db.Decimal(10, 2)
  bookings   Booking[]
  locks      SeatLock[]
}

model User {
  id         String    @id @default(uuid())
  email      String    @unique
  firstName  String
  lastName   String
  password   String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isActive   Boolean   @default(true)
  imagePath  String    @default("")
  isVerified Boolean   @default(false)
  bookings   Booking[]
}

model Booking {
  id         String        @id @default(uuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  showtimeId String
  showtime   Showtime      @relation(fields: [showtimeId], references: [id])

  // Relations to multiple seats
  seats          Seat[]        // Implicit many-to-many OR join table
  
  ticketPrice    Decimal   @db.Decimal(10, 2) // Seat base price + tier multiplier
  convenienceFee Decimal   @default(1.50) @db.Decimal(10, 2)
  totalAmount    Decimal   @db.Decimal(10, 2)
  
  paymentId  String?       // Payment Gateway Transaction ID (Stripe / Razorpay)
  bookedAt   DateTime      @default(now())
  status     BookingStatus @default(PENDING_PAYMENT)
}

model SeatLock {
  id         String   @id @default(uuid())
  seatId     String
  showtimeId String
  userId     String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  showtime   Showtime @relation(fields: [showtimeId], references: [id])
}